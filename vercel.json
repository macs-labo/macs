{
  "cleanUrls": false,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "macs/**"
    }
  },
  "routes": [
    { "src": "/macs/(.*\\.(js|css|png|jpg|gif|ico|svg))$", "dest": "/macs/$1" },
    { "src": "/macs/(.*)", "dest": "/api/index.php" },
    { "handle": "filesystem" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false
    }
  }
}

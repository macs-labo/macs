{
  "trailingSlash": false,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "{macs/**/*.php,data/*.db,macs/templates/*.html}"
    }
  },
  "rewrites": [
    { "source": "/macs/:path*", "destination": "/api/index.php" },
    { "source": "/acfinder", "destination": "/acfinder/index.html" },
    { "source": "/data", "destination": "/data/index.html" }
  ]
}

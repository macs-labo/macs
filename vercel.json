{
  "trailingSlash": false,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "{macs/**/*.php,data/*.db,macs/templates/*.html}"
    }
  },
  "redirects": [
    {
      "source": "/acfinder",
      "destination": "/acfinder/crop.html",
      "permanent": false
    },
    {
      "source": "/acfinder/index.html",
      "destination": "/acfinder/crop.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/macs/(.*)",
      "destination": "/api/index.php"
    }
  ]
}

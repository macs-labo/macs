{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "{macs/**/*.php,data/*.db,macs/templates/*.html}"
    },
    "macs/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "{macs/**/*.php,data/*.db,macs/templates/*.html}"
    }
  },
  "rewrites": [
    {
      "source": "/macs/index.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/macs/:path*",
      "destination": "/api/index.php"
    }
  ]
}
